generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  USER
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  BLOCKED
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum SubscriptionPlan {
  SILVER
  GOLD
  PLATINUM
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  roleName       RoleName  @default(USER)
  firstName      String?
  lastName       String?
  phone          String?   @unique
  password       String?
  profession     String?
  education      String?
  city           String?
  religion       String?
  community      String?
  motherTongue   String?
  bio            String?
  birthDate      DateTime? @db.Date
  gender         String?
  maritalStatus  String?
  height         String?
  isApproved     Boolean   @default(false)
  profileVisible Boolean   @default(false)
  isPremium      Boolean   @default(false)
  premiumExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime? // soft delete — null means active

  familyDetails FamilyDetails?
  horoscope     Horoscope?
  preferences   Preferences?

  approvalsGiven ApprovalLog[] @relation("AdminApprovals")
  approvalsFor   ApprovalLog[] @relation("UserApprovals")

  accounts               Account[]
  sessions               Session[]
  photos                 Photo[]
  interestsSent          Interest[]     @relation("InterestSender")
  interestsReceived      Interest[]     @relation("InterestRecipient")
  conversationsAsUserOne Conversation[] @relation("ConversationUserOne")
  conversationsAsUserTwo Conversation[] @relation("ConversationUserTwo")
  messagesSent           Message[]
  shortlists             Shortlist[]    @relation("ShortlistOwner")
  shortlistedBy          Shortlist[]    @relation("ShortlistProfile")
  blocksInitiated        Block[]        @relation("BlockInitiator")
  blocksReceived         Block[]        @relation("BlockRecipient")
  payments               Payment[]
  subscriptions          Subscription[]

  // Indexes for browse/filter queries — eliminates full table scans
  @@index([isApproved, profileVisible, gender])
  @@index([isApproved, profileVisible, city])
  @@index([isApproved, profileVisible, religion])
  @@index([isApproved, profileVisible, education])
  @@index([isApproved, profileVisible, profession])
  @@index([isApproved, profileVisible, community])
  @@index([isApproved, profileVisible, birthDate])
  @@index([createdAt])
}

model FamilyDetails {
  id              Int    @id @default(autoincrement())
  userId          String @unique
  fatherName      String
  motherName      String
  totalBrothers   Int
  totalSisters    Int
  marriedBrothers Int
  marriedSisters  Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Horoscope {
  id                 Int     @id @default(autoincrement())
  userId             String  @unique
  horoscopeAvailable Boolean
  manglik            Boolean
  nakshatra          String
  rashi              String
  gotra              String
  gan                String?
  nadi               String?
  charan             String?
  chart              Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Preferences {
  id                 Int     @id @default(autoincrement())
  userId             String  @unique
  castePreference    String?
  subCastePreference String?
  expectations       String?
  preferredAgeRange  String?
  religionCommunity  String?
  locationPreference String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApprovalLog {
  id         Int              @id @default(autoincrement())
  adminId    String
  userId     String
  decision   ApprovalDecision
  remarks    String?
  actionDate DateTime         @default(now())

  admin User @relation("AdminApprovals", fields: [adminId], references: [id], onDelete: Cascade)
  user  User @relation("UserApprovals", fields: [userId], references: [id], onDelete: Cascade)
}

model Photo {
  id               Int         @id @default(autoincrement())
  userId           String
  url              String
  publicId         String?
  status           PhotoStatus @default(PENDING)
  rejectionRemarks String?
  isPrimary        Boolean     @default(false)
  createdAt        DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Interest {
  id          Int            @id @default(autoincrement())
  fromUserId  String
  toUserId    String
  status      InterestStatus @default(PENDING)
  message     String?
  respondedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  fromUser User @relation("InterestSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("InterestRecipient", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model Conversation {
  id            Int       @id @default(autoincrement())
  userOneId     String
  userTwoId     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  userOne  User      @relation("ConversationUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo  User      @relation("ConversationUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
  @@index([lastMessageAt])
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([readAt, senderId])
}

model Shortlist {
  id            Int      @id @default(autoincrement())
  userId        String
  profileUserId String
  createdAt     DateTime @default(now())

  user        User @relation("ShortlistOwner", fields: [userId], references: [id], onDelete: Cascade)
  profileUser User @relation("ShortlistProfile", fields: [profileUserId], references: [id], onDelete: Cascade)

  @@unique([userId, profileUserId])
  @@index([profileUserId])
}

model Block {
  id            Int      @id @default(autoincrement())
  blockerId     String
  blockedUserId String
  reason        String?
  createdAt     DateTime @default(now())

  blocker     User @relation("BlockInitiator", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser User @relation("BlockRecipient", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Payment {
  id                String           @id @default(cuid())
  userId            String
  plan              SubscriptionPlan
  listAmountPaise   Int
  discountPercent   Int
  amountPaise       Int
  status            PaymentStatus    @default(CREATED)
  razorpayOrderId   String           @unique
  razorpayPaymentId String?          @unique
  razorpaySignature String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?

  @@index([userId, status])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  plan      SubscriptionPlan
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  expiresAt DateTime
  paymentId String             @unique
  createdAt DateTime           @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

