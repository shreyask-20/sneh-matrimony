DESIGN_RULES.md
reports/

# ─── Test & load-test scripts (local only, never commit) ──────────────────────
scripts/k6/
scripts/test-*.cjs
scripts/test-*.mjs
scripts/run-load-tests.mjs
scripts/generate-load-report.mjs
scripts/generate-unit-report.mjs
scripts/seed-load-test-users.cjs
scripts/check-seed-users.cjs
scripts/check-conversation.cjs

# Error reports and screenshots (local only, never commit)
# Ignore markdown files named with "error" or "errors"
*error*.md
*errors*.md
*.error.md
*.err.md

# Dedicated directory for error reports
errors/

# Screenshots and images used for error reporting
screenshots/
screenshots/**/*.png
screenshots/**/*.jpg
screenshots/**/*.jpeg
screenshot*.png
screenshot*.jpg
*.screenshot.png
*.screenshot.jpg

# Test result images (local only, never commit)
# Common test results folders and image patterns
test-results/
test-results/**/*.png
test-results/**/*.jpg
test-results/**/*.jpeg
test-results/**/*.gif

tests/results/
tests/results/**/*.png
tests/results/**/*.jpg
tests/results/**/*.jpeg
tests/results/**/*.gif

reports/**/*.png
reports/**/*.jpg
reports/**/*.jpeg
reports/**/*.gif

# CI artifacts and screenshots from test runs
artifacts/
artifacts/**/*.png
artifacts/**/*.jpg
artifacts/**/*.jpeg
artifacts/**/*.gif

# Playwright/screenshots
playwright-report/
playwright-report/**/*.png
playwright-report/**/*.jpg

# Jest/Puppeteer snapshots or screenshots
__image_snapshots__/
__image_snapshots__/**/*.png
__image_snapshots__/**/*.jpg

# Mocha or other test screenshot folders
mochawesome-report/
mochawesome-report/**/*.png

# Misc patterns
*.test.png
*.test.jpg
*.test.jpeg
*.spec.png
*.spec.jpg
*.spec.jpeg

# Snapshot directories and generated test images
*-snapshots/
**/*-snapshots/
tests/**/*.{png,jpg,jpeg,gif,svg,webp}
**/*.{png,jpg,jpeg,gif,svg,webp}

# Test scripts, configs and test code (local only, never commit)
# Test directories
tests/
test/
**/tests/

# Common test file patterns
**/*.spec.{js,ts,tsx,cjs,mjs}
**/*.test.{js,ts,tsx,cjs,mjs}
**/*.e2e.{js,ts,tsx,cjs,mjs}
**/*.integration.{js,ts,tsx,cjs,mjs}

# Test runner configs and fixtures
playwright.config.*
vitest.config.*
jest.config.*
jest.*
karma.conf.*
cypress/
.cypress/

# Test helper and setup scripts
test-setup.*
setupTests.*
**/setupTests.*

# Scripts containing tests
scripts/test*/
scripts/**/*test*
scripts/**/*spec*
scripts/**/*.spec.*
scripts/**/*.test.*

# Coverage and instrumentation
.nyc_output/
coverage/

# Misc test artifacts
*.spec.*
*.test.*
