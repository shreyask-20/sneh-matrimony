{
  "name": "sneha-matrimonial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && prisma generate",
    "dev": "next dev",
    "prebuild": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "node prisma/seed.cjs",
    "test": "vitest",
    "test:run": "vitest run --reporter=json --outputFile=reports/unit-results.json && node scripts/generate-unit-report.mjs",
    "test:load:seed": "node scripts/seed-load-test-users.cjs",
    "test:endpoints": "node scripts/test-all-endpoints.cjs",
    "test:reject-delete": "node scripts/test-reject-delete.cjs",
    "test:diagnose": "node scripts/run-load-tests.mjs diagnostic",
    "test:smoke": "node scripts/run-load-tests.mjs smoke",
    "test:load": "node scripts/run-load-tests.mjs load",
    "test:stress": "node scripts/run-load-tests.mjs stress",
    "test:spike": "node scripts/run-load-tests.mjs spike"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@radix-ui/react-slot": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "next-auth": "^4.24.13",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.12.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.2"
  }
}
